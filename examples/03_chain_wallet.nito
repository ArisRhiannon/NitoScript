# 03 — Chains: a thing that remembers, and the actions that change it
#
# A 'chain' has 'state' (what it remembers) and 'block' transitions
# (the only ways to change it). Every change is recorded and hash-linked,
# so the chain can prove its own history by replay — no mining, no servers.
#
# Value is denominated in Nito: 1 Nito = 100 Nitters (the fraction).

chain Wallet:
    state:
        balance = 0 nito
    block deposit(amount):
        balance = balance + amount
    block withdraw(amount):
        if balance >= amount:
            balance = balance - amount
        else:
            fail "Insufficient funds"     # a failed action changes nothing

let w = new Wallet()
w.deposit(100 nito)
w.withdraw(30 nito)
w.withdraw(50 nitters)                     # 0.50 Nito

show "balance: " + w.balance               # Ñ69.50
show "root:    " + w.root                  # SHA-256 fingerprint of the whole state
show "verify:  " + w.verify()              # true
show "replay reproduces root: " + (w.replay() == w.root)
